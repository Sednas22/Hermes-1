    {
        "id": "fn_processa",
        "type": "function",
        "z": "tab_hermes1",
        "name": "Processa telemetria",
        "func": "var dados = msg.payload;\n\nvar o2 = dados.o2;\nvar pressao = dados.pressao;\nvar temperatura = dados.temperatura;\nvar alerta = dados.alerta;\n\nvar msg_o2 = { payload: o2, topic: 'O2' };\nvar msg_pressao = { payload: pressao, topic: 'Pressao' };\nvar msg_temp = { payload: temperatura, topic: 'Temperatura' };\n\nvar status;\nif (alerta === 1 || alerta === true || alerta === 'true') {\n    status = '🔴 CRÍTICO - Parâmetro fora do limite de segurança';\n} else {\n    status = '🟢 NOMINAL - Todos os sistemas operacionais';\n}\nvar msg_status = { payload: status };\n\nvar msg_chart_o2 = { payload: o2, topic: 'O2 (%)' };\nvar msg_chart_pressao = { payload: pressao, topic: 'Pressão (kPa)' };\nvar msg_chart_temp = { payload: temperatura, topic: 'Temperatura (°C)' };\n\nreturn [msg_o2, msg_pressao, msg_temp, msg_status, msg_chart_o2, msg_chart_pressao, msg_chart_temp];",
        "outputs": 7,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 120,
        "wires": [
